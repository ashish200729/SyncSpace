// =============================================================================
// Prisma Schema — Collaborative Project & Task Management System
// Better Auth compatible + workspace-safe relational constraints
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum WorkspaceRole {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMMENTED
  TASK_DUE_SOON
  TASK_OVERDUE
  WORKSPACE_INVITE
  WORKSPACE_JOINED
  MENTION
}

enum ActivityAction {
  // Workspace
  WORKSPACE_CREATED
  WORKSPACE_UPDATED
  WORKSPACE_MEMBER_ADDED
  WORKSPACE_MEMBER_REMOVED

  // Task
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_STATUS_CHANGED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_DUE_DATE_SET
  TASK_PRIORITY_CHANGED

  // Comment
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
}

// =============================================================================
// AUTHENTICATION (BETTER AUTH CORE TABLES)
// =============================================================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // App fields
  username   String?   @unique
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?

  // Better Auth relations
  sessions Session[]
  accounts Account[]

  // App relations
  ownedWorkspaces         Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers        WorkspaceMember[]
  invitedWorkspaceMembers WorkspaceMember[] @relation("WorkspaceMemberInviter")
  createdTasks            Task[]            @relation("TaskCreatorUser")
  assignedTasks           Task[]            @relation("TaskAssigneeUser")
  comments                Comment[]         @relation("CommentAuthorUser")
  notifications           Notification[]    @relation("NotificationRecipient")
  triggeredNotifications  Notification[]    @relation("NotificationActor")
  activityLogs            ActivityLog[]     @relation("ActivityActor")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@index([providerId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@index([expiresAt])
  @@map("verifications")
}

// =============================================================================
// WORKSPACE
// =============================================================================

model Workspace {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  inviteCode      String?   @unique
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?
  inviteEnabled   Boolean   @default(true)
  ownerId         String
  owner           User      @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members       WorkspaceMember[]
  tasks         Task[]
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@index([ownerId])
  @@index([inviteEnabled, inviteExpiresAt])
  @@map("workspaces")
}

// =============================================================================
// WORKSPACE MEMBER
// ownerId on Workspace is the source of truth for ownership.
// The owner's membership row should be created in the same transaction with role ADMIN.
// =============================================================================

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  leftAt      DateTime?
  invitedById String?
  invitedBy   User?         @relation("WorkspaceMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  createdTasks  Task[]        @relation("TaskCreatorMembership")
  assignedTasks Task[]        @relation("TaskAssigneeMembership")
  comments      Comment[]     @relation("CommentAuthorMembership")
  activityLogs  ActivityLog[] @relation("ActivityActorMembership")

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([workspaceId, leftAt])
  @@index([userId, leftAt])
  @@map("workspace_members")
}

// =============================================================================
// TASK
// creator/assignee are constrained to workspace membership using composite FKs.
// =============================================================================

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  position    Float        @default(0)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  creatorId          String
  creator            User             @relation("TaskCreatorUser", fields: [creatorId], references: [id], onDelete: Restrict)
  creatorMembership  WorkspaceMember  @relation("TaskCreatorMembership", fields: [workspaceId, creatorId], references: [workspaceId, userId], onDelete: Restrict)
  assigneeId         String?
  assignee           User?            @relation("TaskAssigneeUser", fields: [assigneeId], references: [id], onDelete: Restrict)
  assigneeMembership WorkspaceMember? @relation("TaskAssigneeMembership", fields: [workspaceId, assigneeId], references: [workspaceId, userId], onDelete: Restrict)

  // Bonus features
  dueDate     DateTime?
  startDate   DateTime?
  completedAt DateTime?

  // Soft delete keeps comments and activity history intact.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      Comment[]
  activityLogs  ActivityLog[]
  notifications Notification[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status, position])
  @@index([workspaceId, assigneeId, status])
  @@index([workspaceId, priority, dueDate])
  @@index([workspaceId, deletedAt, createdAt])
  @@index([creatorId])
  @@index([dueDate])
  @@map("tasks")
}

// =============================================================================
// COMMENT
// workspaceId is duplicated intentionally so the database can enforce author membership.
// =============================================================================

model Comment {
  id               String          @id @default(cuid())
  content          String
  workspaceId      String
  taskId           String
  task             Task            @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  authorId         String
  author           User            @relation("CommentAuthorUser", fields: [authorId], references: [id], onDelete: Restrict)
  authorMembership WorkspaceMember @relation("CommentAuthorMembership", fields: [workspaceId, authorId], references: [workspaceId, userId], onDelete: Restrict)
  isEdited         Boolean         @default(false)
  editedAt         DateTime?
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([taskId, createdAt])
  @@index([workspaceId, deletedAt])
  @@index([authorId])
  @@map("comments")
}

// =============================================================================
// NOTIFICATION [BONUS]
// =============================================================================

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  body   String?
  isRead Boolean          @default(false)
  readAt DateTime?

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([workspaceId, createdAt])
  @@index([taskId, createdAt])
  @@index([actorId])
  @@map("notifications")
}

// =============================================================================
// ACTIVITY LOG [BONUS]
// =============================================================================

model ActivityLog {
  id              String          @id @default(cuid())
  action          ActivityAction
  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actorId         String
  actor           User            @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorMembership WorkspaceMember @relation("ActivityActorMembership", fields: [workspaceId, actorId], references: [workspaceId, userId], onDelete: Restrict)
  metadata        Json?
  createdAt       DateTime        @default(now())

  @@index([workspaceId, createdAt])
  @@index([taskId, createdAt])
  @@index([actorId, createdAt])
  @@map("activity_logs")
}
